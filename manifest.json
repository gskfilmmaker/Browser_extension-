{
  "manifest_version": 3,
  "name": "AI Browser Agent",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "An approval-first browser agent for OpenAI and Anthropic.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "debugger",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open AI Browser Agent",
    "default_icon": {
      "128": "icons/128.png"
    }
  },
  "icons": {
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_page": "options/index.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.openai.com https://api.anthropic.com"
  }
}
